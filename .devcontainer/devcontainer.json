{
  "name": "GameplayFootball",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Gra (noVNC)",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "cd /workspaces/gameplayfootball-browser && git pull && bash .devcontainer/start.sh",
  "remoteEnv": {
    "DISPLAY": ":1",
    "LIBGL_ALWAYS_SOFTWARE": "1",
    "GALLIUM_DRIVER": "llvmpipe",
    "ALSOFT_DRIVERS": "null"
  }
}
